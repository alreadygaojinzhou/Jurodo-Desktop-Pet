<Window x:Class="TojirouPet.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="和斗次郎说话" Width="380" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" FontFamily="Microsoft YaHei UI">
    <Border Background="#F5161412" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
        <StackPanel>
            <Grid Height="36" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TitleText" Text="斗次郎" Foreground="#FFE8DCC8" FontSize="13" FontWeight="SemiBold"
                           Margin="14,0,0,0" VerticalAlignment="Center" />
                <Button Content="清空" Width="44" Height="36" Margin="0,0,36,0"
                        HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                        Foreground="#88FFFFFF" FontSize="11" Cursor="Hand" Click="Clear_Click" />
                <Button Content="✕" Width="34" Height="36" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="#99FFFFFF"
                        FontSize="13" Cursor="Hand" Click="Close_Click" />
            </Grid>

            <ScrollViewer x:Name="TranscriptScroll" MinHeight="110" MaxHeight="280"
                          VerticalScrollBarVisibility="Auto" Padding="0">
                <StackPanel x:Name="Transcript" Margin="12,4,12,10" />
            </ScrollViewer>

            <Grid Margin="12,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Background="#22FFFFFF" CornerRadius="8" Padding="8,0">
                    <TextBox x:Name="Input" Background="Transparent" BorderThickness="0"
                             Foreground="#FFF6F0E6" CaretBrush="#FFF6F0E6" FontSize="13"
                             VerticalContentAlignment="Center" Height="34"
                             KeyDown="Input_KeyDown" />
                </Border>
                <Button Grid.Column="1" Content="说" Width="46" Height="34" Margin="8,0,0,0"
                        Background="#FFC8732E" Foreground="White" BorderThickness="0"
                        FontSize="13" Cursor="Hand" Click="Send_Click" />
            </Grid>

            <TextBlock x:Name="Hint" Text="" Foreground="#88FFB37A" FontSize="11"
                       Margin="14,0,14,10" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
