<Window x:Class="TojirouPet.InteractionRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="斗次郎 · 互动规则" Width="430" Height="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual" FontFamily="Microsoft YaHei UI">
    <Window.Resources>
        <Style x:Key="RuleText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFF1E7D8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="22" />
        </Style>
    </Window.Resources>

    <Border Background="#F51B1815" CornerRadius="14" BorderBrush="#55C8732E" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <Grid Background="#18C8732E" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Border Width="4" Height="20" Background="#FFC8732E" CornerRadius="2" />
                    <TextBlock Text="互动规则" Margin="10,0,0,0" Foreground="#FFF4E9D8"
                               FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="✕" Width="42" Height="44" HorizontalAlignment="Right"
                        Background="Transparent" BorderThickness="0" Foreground="#AAFFFFFF"
                        FontSize="14" Cursor="Hand" Click="Close_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="18,14,18,4">
                <StackPanel>
                    <TextBlock Text="直接摸摸他" Foreground="#FFFFB36B" FontSize="15"
                               FontWeight="SemiBold" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource RuleText}">
                        左键点头部：摸头，好感 +1.2、心情 +2.5。<LineBreak />
                        左键点身体：摸身体，好感 +0.5、心情 +1。<LineBreak />
                        按住移动：超过约 5px 就会跟手拖拽，松手放下。<LineBreak />
                        右键或原地长按约 0.4 秒：打开桌宠菜单。
                    </TextBlock>

                    <TextBlock Text="投喂" Foreground="#FFFFB36B" FontSize="15"
                               FontWeight="SemiBold" Margin="0,18,0,8" />
                    <TextBlock Style="{StaticResource RuleText}">
                        烤肉：饱食 +26、心情 +6、好感 +1.5。<LineBreak />
                        饭团：饱食 +14、心情 +3、好感 +0.5。<LineBreak />
                        递根烟：心情 +16、饱食 -2、好感 +1。<LineBreak />
                        啤酒：饱食 +8、心情 +11、好感 +1。
                    </TextBlock>

                    <TextBlock Text="状态变化" Foreground="#FFFFB36B" FontSize="15"
                               FontWeight="SemiBold" Margin="0,18,0,8" />
                    <TextBlock Style="{StaticResource RuleText}">
                        饱食约 14 小时见底，心情约 10 小时见底。<LineBreak />
                        饱食过低会催饭；饱食或心情长期过低会进入丧/呆状态。<LineBreak />
                        健康低于 40 时会显示生病状态。数值和位置会自动保存。
                    </TextBlock>

                    <TextBlock Text="菜单功能" Foreground="#FFFFB36B" FontSize="15"
                               FontWeight="SemiBold" Margin="0,18,0,8" />
                    <TextBlock Style="{StaticResource RuleText}">
                        选择角色：切换任意已经制作好动画包的角色。<LineBreak />
                        和当前角色说话：打开 AI 对话。<LineBreak />
                        换装：工装、西装、浴衣、祭典和盘腿坐。<LineBreak />
                        大小：180px / 270px（默认）/ 360px / 450px。<LineBreak />
                        开机自启动：可在这里随时开启或关闭。<LineBreak />
                        总在最前：切换是否盖在其他窗口上。<LineBreak />
                        躲到托盘：双击托盘图标召回，托盘右键可退出。
                    </TextBlock>

                    <Border Background="#141B74C8" CornerRadius="8" Padding="12,9" Margin="0,18,0,4">
                        <TextBlock Foreground="#DDF4E9D8" FontSize="12" TextWrapping="Wrap" LineHeight="19">
                            小提示：窗口透明区域目前仍会拦住鼠标；碰到挡住别处的情况，可以把斗次郎拖开或躲到托盘。
                        </TextBlock>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="知道了" Width="104" Height="34"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0"
                    Background="#FFC8732E" Foreground="White" BorderThickness="0"
                    FontSize="13" Cursor="Hand" Click="Close_Click" />
        </Grid>
    </Border>
</Window>
